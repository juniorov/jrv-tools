rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // --- cart-wise (prefijo cartwise_) ---
    match /cartwise_businesses/{businessId} {
      allow read, write: if isSignedIn();
    }

    match /cartwise_products/{productId} {
      allow read, write: if isSignedIn();
    }

    match /cartwise_settings/{settingId} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId}/cartwise_cart/{productId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Perfil compartido del suite (favoritos/preferencias multi-app a futuro).
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- ahorros (prefijo ahorros_) ---
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /ahorros_entities/{entityId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
    }

    match /ahorros_accounts/{accountId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);

      match /movements/{movementId} {
        allow read, write: if isOwner(
          get(/databases/$(database)/documents/ahorros_accounts/$(accountId)).data.ownerId
        );
      }
    }

    match /ahorros_goals/{goalId} {
      allow read: if isOwner(resource.data.ownerId)
        || (isSignedIn() && resource.data.sharedWith[request.auth.uid] != null)
        // Necesario para que el invitado descubra su invitación pendiente y se auto-reclame.
        || (isSignedIn() && resource.data.pendingInvites[request.auth.token.email.lower()] != null)
        // Variantes con array-contains: Firestore solo puede validar de forma segura una query
        // de LISTA (where/getDocs) contra las reglas si puede probar la condición a partir del
        // propio filtro de la query; no puede hacerlo con una clave dinámica de mapa
        // (sharedWith[uid] != null), así que las queries de "objetivos compartidos conmigo" e
        // "invitaciones pendientes" filtran por estos arreglos denormalizados en su lugar.
        || (isSignedIn() && request.auth.uid in resource.data.get('sharedWithUids', []))
        || (isSignedIn() && request.auth.token.email.lower() in resource.data.get('pendingInviteEmails', []));
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId)
        || (isSignedIn() && resource.data.sharedWith[request.auth.uid] == 'editor')
        // Auto-reclamo: quien tiene una invitación pendiente a su email puede escribir su
        // propio uid en sharedWith con el mismo rol que se le ofreció, sin depender de una
        // Cloud Function (este repo es 100% frontend estático sobre Netlify).
        || (isSignedIn()
            && resource.data.pendingInvites[request.auth.token.email.lower()] != null
            && request.resource.data.sharedWith[request.auth.uid]
               == resource.data.pendingInvites[request.auth.token.email.lower()]);
      allow delete: if isOwner(resource.data.ownerId);

      match /movements/{movementId} {
        allow read: if isOwner(
          get(/databases/$(database)/documents/ahorros_goals/$(goalId)).data.ownerId
        ) || (isSignedIn() &&
          get(/databases/$(database)/documents/ahorros_goals/$(goalId)).data.sharedWith[request.auth.uid] != null);
        allow write: if isOwner(
          get(/databases/$(database)/documents/ahorros_goals/$(goalId)).data.ownerId
        ) || (isSignedIn() &&
          get(/databases/$(database)/documents/ahorros_goals/$(goalId)).data.sharedWith[request.auth.uid] == 'editor');
      }
    }

    // --- lunar-garden (prefijo lunar_garden_) ---
    match /lunar_garden_lots/{lotId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);

      match /records/{recordId} {
        allow read, write: if isOwner(
          get(/databases/$(database)/documents/lunar_garden_lots/$(lotId)).data.ownerId
        );
      }
    }

    // --- gym-log (prefijo gym_log_) ---
    match /gym_log_routines/{routineId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
    }

    match /gym_log_workouts/{workoutId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
    }

    // Doc id = uid (una sola sesión activa por usuario), por eso la regla compara directo
    // contra el id del documento en vez de leer un campo ownerId.
    match /gym_log_active_sessions/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Doc id = uid: plantilla recurrente del plan semanal, y su intercambio puntual de la
    // semana en curso (mismo patrón que gym_log_active_sessions).
    match /gym_log_weekly_plan/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /gym_log_week_overrides/{uid} {
      allow read, write: if isOwner(uid);
    }

    // --- recetas (prefijo recetas_) ---
    match /recetas_recipes/{recipeId} {
      allow read, update, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
    }

    // Compartida entre apps: resuelve email -> uid para invitar a objetivos de ahorros.
    match /users_by_email/{email} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // --- Colecciones viejas (sin prefijo): se mantienen activas solo durante la
    // migración a las de arriba. Borrar este bloque (y las colecciones) una vez
    // confirmada la migración. ---
    match /businesses/{businessId} {
      allow read, write: if isSignedIn();
    }

    match /products/{productId} {
      allow read, write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId}/cart/{productId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
